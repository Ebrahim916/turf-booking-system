# Copy to .env and adjust. Never commit the real .env.

# --- Application ---
APP_NAME="Turf Booking System API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Host is the compose service name when running the API inside compose.
# Use localhost when running uvicorn directly on the host.
POSTGRES_USER=turf
POSTGRES_PASSWORD=turf
POSTGRES_DB=turf_booking
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://turf:turf@localhost:5433/turf_booking

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed origins. Must be explicit (no wildcard)
# because the refresh cookie is sent with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Seed data ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
